{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/pair-confirm.schema.json",
  "title": "PairConfirm",
  "description": "Confirms a pairing handshake",
  "type": "object",
  "required": ["device_id", "pairing_code"],
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Device identifier from /pair/start response",
      "minLength": 1
    },
    "pairing_code": {
      "type": "string",
      "description": "The pairing code displayed by the other device",
      "minLength": 1,
      "examples": ["ABCD-1234"]
    },
    "pin_proof": {
      "type": "string",
      "description": "blake3(pin + server_nonce) to prove PIN knowledge without revealing it"
    },
    "pin_proof_signature": {
      "type": "string",
      "description": "Ed25519 signature of pin_proof (base64)"
    }
  }
}
