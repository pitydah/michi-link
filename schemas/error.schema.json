{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/error.schema.json",
  "title": "Error",
  "description": "Standard error response payload used across all API endpoints",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "description": "Machine-readable error code",
      "examples": ["INVALID_REQUEST", "NOT_FOUND", "UNAUTHORIZED", "INTERNAL_ERROR", "PAIRING_REQUIRED"]
    },
    "message": {
      "type": "string",
      "description": "Human-readable error description",
      "minLength": 1,
      "maxLength": 512,
      "examples": ["The requested track was not found"]
    },
    "details": {
      "type": "object",
      "description": "Additional structured error context",
      "examples": [{"field": "position_ms", "reason": "must be a non-negative integer"}]
    }
  }
}
