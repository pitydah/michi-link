{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/error.schema.json",
  "title": "Error",
  "description": "Standard error response payload (v1.0.0 official format)",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error code",
          "examples": ["INVALID_REQUEST", "NOT_FOUND", "UNAUTHORIZED", "FORBIDDEN", "INTERNAL_ERROR", "NOT_IMPLEMENTED", "TRACK_NOT_FOUND", "RANGE_NOT_SATISFIABLE", "PAIRING_REQUIRED"]
        },
        "message": {
          "type": "string",
          "description": "Human-readable error description",
          "minLength": 1,
          "maxLength": 512,
          "examples": ["The requested track was not found"]
        },
        "details": {
          "type": "object",
          "description": "Additional structured error context",
          "default": {},
          "examples": [{"field": "position_ms", "reason": "must be a non-negative integer"}]
        }
      }
    }
  }
}
