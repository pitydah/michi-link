{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/sync-manifest.schema.json",
  "title": "SyncManifest",
  "description": "Full library manifest used for initial synchronisation or full resync",
  "type": "object",
  "required": ["cursor", "generated_at", "tracks"],
  "properties": {
    "cursor": {
      "type": "string",
      "description": "Opaque cursor token for the first delta request",
      "examples": ["initial_cursor_a1b2c3d4"]
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when this manifest was generated",
      "format": "date-time",
      "examples": ["2026-06-29T12:00:00Z"]
    },
    "tracks": {
      "type": "array",
      "description": "Full list of track objects in the library",
      "items": {
        "type": "object",
        "required": ["id", "title", "artist"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "artist": { "type": "string" },
          "album": { "type": "string" },
          "duration_ms": { "type": "integer" },
          "duration": { "type": "number" },
          "track_number": { "type": "integer" },
          "disc_number": { "type": "integer" },
          "year": { "type": "integer" },
          "format": { "type": "string" },
          "size": { "type": "integer" },
          "md5": { "type": "string" },
          "artwork_md5": { "type": "string" },
          "modified_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "albums": { "type": "array", "items": { "type": "object" } },
    "artists": { "type": "array", "items": { "type": "object" } },
    "playlists": { "type": "array", "items": { "type": "object" } },
    "artworks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "md5": { "type": "string" }
        }
      }
    }
  }
}
