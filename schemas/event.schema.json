{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/event.schema.json",
  "title": "Event",
  "description": "WebSocket event envelope for real-time communication",
  "type": "object",
  "required": ["type", "data", "timestamp"],
  "properties": {
    "type": {
      "type": "string",
      "description": "Event type identifier",
      "minLength": 1,
      "examples": [
        "playback.state_changed",
        "playback.track_changed",
        "queue.updated",
        "library.updated",
        "device.online",
        "device.offline",
        "room.updated",
        "sync.manifest",
        "sync.delta",
        "pair.completed",
        "pair.revoked"
      ]
    },
    "data": {
      "type": "object",
      "description": "Event-specific payload data"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp when the event was generated",
      "format": "date-time",
      "examples": ["2025-06-20T10:05:00Z"]
    }
  }
}
