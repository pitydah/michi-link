{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/audio-chain.schema.json",
  "title": "AudioChain",
  "description": "Configuration for an audio processing chain: source → controller → output",
  "type": "object",
  "required": ["id", "name", "source", "controller", "output"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique audio chain identifier",
      "minLength": 1,
      "examples": ["chain_p7q8r9s0"]
    },
    "name": {
      "type": "string",
      "description": "Human-readable chain name",
      "maxLength": 128,
      "examples": ["Living Room HiFi Chain"]
    },
    "source": {
      "type": "object",
      "description": "Audio source configuration",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Source type",
          "examples": ["library", "stream", "line_in", "airplay", "bluetooth"]
        },
        "config": {
          "type": "object",
          "description": "Source-specific configuration parameters"
        }
      }
    },
    "controller": {
      "type": "object",
      "description": "Audio processing / controller configuration",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Controller type",
          "examples": ["michi_sync", "michi_volume", "passthrough", "equalizer"]
        },
        "config": {
          "type": "object",
          "description": "Controller-specific configuration parameters"
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Audio output configuration",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Output type",
          "examples": ["alsa", "pulse", "airplay", "chromecast", "http_stream", "michi_receiver"]
        },
        "config": {
          "type": "object",
          "description": "Output-specific configuration parameters"
        }
      }
    },
    "profile": {
      "type": "string",
      "description": "Quality profile identifier",
      "enum": ["standard", "high", "lossless", "custom"],
      "examples": ["lossless"]
    }
  }
}
