{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/sync-delta.schema.json",
  "title": "SyncDelta",
  "description": "Incremental changes since last synchronisation to keep peers in sync",
  "type": "object",
  "required": ["device_id", "sync_id", "generated_at", "changes"],
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Source device identifier",
      "minLength": 1
    },
    "sync_id": {
      "type": "string",
      "description": "Unique identifier for this delta operation",
      "minLength": 1
    },
    "base_sync_id": {
      "type": "string",
      "description": "The sync_id this delta is based on",
      "examples": ["sync_b7c8d9e0"]
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when this delta was generated",
      "format": "date-time"
    },
    "changes": {
      "type": "object",
      "description": "Set of changes grouped by entity type",
      "required": ["tracks", "albums", "artists", "playlists"],
      "properties": {
        "tracks": {
          "type": "object",
          "description": "Track changes",
          "properties": {
            "added": {
              "type": "array",
              "items": { "$ref": "track.schema.json" }
            },
            "updated": {
              "type": "array",
              "items": { "$ref": "track.schema.json" }
            },
            "removed": {
              "type": "array",
              "items": { "type": "string", "description": "Track ID" }
            }
          }
        },
        "albums": {
          "type": "object",
          "description": "Album changes",
          "properties": {
            "added": {
              "type": "array",
              "items": { "$ref": "album.schema.json" }
            },
            "updated": {
              "type": "array",
              "items": { "$ref": "album.schema.json" }
            },
            "removed": {
              "type": "array",
              "items": { "type": "string", "description": "Album ID" }
            }
          }
        },
        "artists": {
          "type": "object",
          "description": "Artist changes",
          "properties": {
            "added": {
              "type": "array",
              "items": { "$ref": "artist.schema.json" }
            },
            "updated": {
              "type": "array",
              "items": { "$ref": "artist.schema.json" }
            },
            "removed": {
              "type": "array",
              "items": { "type": "string", "description": "Artist ID" }
            }
          }
        },
        "playlists": {
          "type": "object",
          "description": "Playlist changes",
          "properties": {
            "added": {
              "type": "array",
              "items": { "$ref": "playlist.schema.json" }
            },
            "updated": {
              "type": "array",
              "items": { "$ref": "playlist.schema.json" }
            },
            "removed": {
              "type": "array",
              "items": { "type": "string", "description": "Playlist ID" }
            }
          }
        }
      }
    }
  }
}
