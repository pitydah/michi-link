{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/sync-delta.schema.json",
  "title": "SyncDelta",
  "description": "Incremental changes since last synchronisation to keep peers in sync, using cursor-based pagination",
  "type": "object",
  "required": ["device_id", "sync_id", "generated_at", "cursor", "added", "updated", "deleted", "playlists_updated"],
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Source device identifier",
      "minLength": 1
    },
    "sync_id": {
      "type": "string",
      "description": "Unique identifier for this delta operation",
      "minLength": 1
    },
    "base_sync_id": {
      "type": "string",
      "description": "The sync_id this delta is based on",
      "examples": ["sync_b7c8d9e0"]
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when this delta was generated",
      "format": "date-time"
    },
    "cursor": {
      "type": "object",
      "description": "Cursor state for paginated sync iteration",
      "required": ["page", "total_pages", "total_items"],
      "properties": {
        "page": {
          "type": "integer",
          "description": "Current page number (1-indexed)",
          "minimum": 1
        },
        "total_pages": {
          "type": "integer",
          "description": "Total number of pages",
          "minimum": 1
        },
        "total_items": {
          "type": "integer",
          "description": "Total number of changed items across all pages",
          "minimum": 0
        }
      }
    },
    "added": {
      "type": "object",
      "description": "Entities added since last sync",
      "properties": {
        "tracks": {
          "type": "array",
          "items": { "$ref": "track.schema.json" }
        },
        "albums": {
          "type": "array",
          "items": { "$ref": "album.schema.json" }
        },
        "artists": {
          "type": "array",
          "items": { "$ref": "artist.schema.json" }
        },
        "playlists": {
          "type": "array",
          "items": { "$ref": "playlist.schema.json" }
        }
      }
    },
    "updated": {
      "type": "object",
      "description": "Entities modified since last sync",
      "properties": {
        "tracks": {
          "type": "array",
          "items": { "$ref": "track.schema.json" }
        },
        "albums": {
          "type": "array",
          "items": { "$ref": "album.schema.json" }
        },
        "artists": {
          "type": "array",
          "items": { "$ref": "artist.schema.json" }
        },
        "playlists": {
          "type": "array",
          "items": { "$ref": "playlist.schema.json" }
        }
      }
    },
    "deleted": {
      "type": "object",
      "description": "Entity IDs removed since last sync",
      "properties": {
        "tracks": {
          "type": "array",
          "items": { "type": "string", "description": "Track ID" }
        },
        "albums": {
          "type": "array",
          "items": { "type": "string", "description": "Album ID" }
        },
        "artists": {
          "type": "array",
          "items": { "type": "string", "description": "Artist ID" }
        },
        "playlists": {
          "type": "array",
          "items": { "type": "string", "description": "Playlist ID" }
        }
      }
    },
    "playlists_updated": {
      "type": "array",
      "description": "List of playlist IDs whose track ordering changed",
      "items": { "type": "string" }
    }
  }
}
