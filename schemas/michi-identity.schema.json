{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/michi-identity.schema.json",
  "title": "MichiIdentity",
  "description": "Ed25519 identity document for the Michi ecosystem",
  "type": "object",
  "required": ["michi_id", "public_key", "algorithm"],
  "properties": {
    "michi_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "64-hex-char hash derived from blake3(Ed25519 public key)"
    },
    "public_key": {
      "type": "string",
      "description": "Ed25519 public key in base64 encoding"
    },
    "algorithm": {
      "type": "string",
      "enum": ["ed25519"],
      "description": "Cryptographic algorithm used"
    },
    "device_name": {
      "type": "string",
      "description": "Human-readable device name"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of key generation"
    }
  }
}
