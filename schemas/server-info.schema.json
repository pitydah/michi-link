{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/server-info.schema.json",
  "title": "ServerInfo",
  "description": "Server identity and capabilities payload (v1.0.0 official format)",
  "type": "object",
  "required": ["service", "name", "server_id", "version", "api_version", "michi_link_version", "roles", "features"],
  "properties": {
    "service": {
      "type": "string",
      "description": "Service identifier: michi-player, michi-micro-server, michi-big-server",
      "enum": ["michi-player", "michi-micro-server", "michi-big-server", "michi-mobile", "michi-stream-standard", "michi-stream-hifi"],
      "examples": ["michi-micro-server"]
    },
    "name": {
      "type": "string",
      "description": "Human-readable server name (user-configurable)",
      "minLength": 1,
      "maxLength": 128,
      "examples": ["Michi Micro Server"]
    },
    "server_id": {
      "type": "string",
      "description": "Unique server UUID",
      "format": "uuid",
      "examples": ["a1b2c3d4-e5f6-7890-abcd-ef1234567890"]
    },
    "version": {
      "type": "string",
      "description": "Application version",
      "examples": ["0.1.0"]
    },
    "api_version": {
      "type": "string",
      "description": "Michi Link API version",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "examples": ["1.0.0"]
    },
    "michi_link_version": {
      "type": "string",
      "description": "Michi Link protocol version",
      "examples": ["1.0.0"]
    },
    "roles": {
      "type": "array",
      "description": "Active roles (see ARCHITECTURE.md for official list)",
      "items": { "type": "string" },
      "uniqueItems": true,
      "examples": [["home_server", "library_server", "stream_server"]]
    },
    "features": {
      "type": "object",
      "description": "Capability descriptors",
      "properties": {
        "library": { "type": "object", "description": "Library capabilities" },
        "streaming": { "type": "object", "description": "Streaming capabilities" },
        "sync": { "type": "object", "description": "Sync capabilities" },
        "playback": { "type": "object", "description": "Playback capabilities" },
        "multiroom": { "type": "object", "description": "Multiroom capabilities" }
      }
    },
    "auth": {
      "type": "object",
      "description": "Authentication methods supported",
      "properties": {
        "pairing": { "type": "boolean" },
        "token_refresh": { "type": "boolean" },
        "methods": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
