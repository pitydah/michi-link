{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/server-info.schema.json",
  "title": "ServerInfo",
  "description": "Server identity and capabilities payload (v1.0.0-alpha official format)",
  "type": "object",
  "required": ["service", "name", "api_version", "michi_link_version", "roles", "features", "auth"],
  "properties": {
    "service": {
      "type": "string",
      "description": "Service identifier",
      "enum": ["michi-music-player", "michi-micro-server", "michi-big-server", "michi-mobile", "michi-stream-standard", "michi-stream-hifi"],
      "examples": ["michi-micro-server"]
    },
    "name": {
      "type": "string",
      "description": "Human-readable server name (user-configurable)",
      "minLength": 1,
      "maxLength": 128,
      "examples": ["Michi Micro Server"]
    },
    "server_id": {
      "type": "string",
      "description": "Unique server UUID",
      "format": "uuid",
      "examples": ["a1b2c3d4-e5f6-7890-abcd-ef1234567890"]
    },
    "version": {
      "type": "string",
      "description": "Application version",
      "examples": ["0.1.0"]
    },
    "api_version": {
      "type": "string",
      "description": "Michi Link API version (use 'v1' for v1.x series)",
      "examples": ["v1", "1.0.0"]
    },
    "michi_link_version": {
      "type": "string",
      "description": "Michi Link protocol version. MUST be a string.",
      "examples": ["1.0.0-alpha"]
    },
    "roles": {
      "type": "array",
      "description": "Active roles (see ARCHITECTURE.md for official list)",
      "items": { "type": "string" },
      "uniqueItems": true,
      "minItems": 1,
      "examples": [["home_server", "library_server", "stream_server"]]
    },
    "features": {
      "type": "object",
      "description": "Simple boolean capability flags in v1.0.0-alpha. Extended capabilities may be added in a future /api/v1/capabilities endpoint.",
      "additionalProperties": { "type": "boolean" },
      "minProperties": 1,
      "examples": [{ "library": true, "search": true, "streaming": true, "sync_manifest": true, "playback": true, "queue": true, "artwork": true, "events": false }]
    },
    "auth": {
      "type": "object",
      "description": "Authentication configuration. REQUIRED for all servers.",
      "required": ["required", "strategy", "token_refresh"],
      "properties": {
        "required": { "type": "boolean", "description": "Whether authentication is mandatory. Always true for v1." },
        "strategy": {
          "type": "string",
          "description": "Auth strategy (see AUTH_PROFILES.md)",
          "enum": ["PLAYER_PASSWORD", "SERVER_CODE", "RECEIVER_BUTTON", "LEGACY"]
        },
        "token_refresh": { "type": "boolean", "description": "Whether /token/refresh is supported" }
      }
    }
  }
}
