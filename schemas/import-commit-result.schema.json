{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/import-commit-result.schema.json",
  "title": "ImportCommitResult",
  "description": "Result of an import commit operation, including track mapping between source and server",
  "type": "object",
  "required": ["session_id", "tracks_imported", "total_tracks"],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "The import session ID",
      "format": "uuid"
    },
    "tracks_imported": {
      "type": "integer",
      "description": "Number of new tracks imported",
      "minimum": 0
    },
    "tracks_skipped": {
      "type": "integer",
      "description": "Number of duplicate tracks skipped",
      "minimum": 0
    },
    "total_tracks": {
      "type": "integer",
      "description": "Total tracks in the session (imported + skipped)",
      "minimum": 0
    },
    "mapping": {
      "type": "object",
      "description": "Source track ID to server track ID mapping",
      "additionalProperties": { "type": "string" },
      "examples": [{ "source_track_001": "server_track_001" }]
    },
    "michi_track_ids": {
      "type": "object",
      "description": "Server track ID to unified michi_track_id mapping",
      "additionalProperties": { "type": "string" },
      "examples": [{ "server_track_001": "michi_track_uuid_001" }]
    }
  }
}
