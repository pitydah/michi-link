{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/pair-start.schema.json",
  "title": "PairStart",
  "description": "Initiates a pairing handshake between two devices",
  "type": "object",
  "required": ["device_name", "device_type"],
  "properties": {
    "device_name": {
      "type": "string",
      "description": "Initiating device display name",
      "minLength": 1,
      "maxLength": 128
    },
    "device_type": {
      "type": "string",
      "description": "Initiating device type",
      "examples": ["mobile", "desktop", "receiver"]
    },
    "roles": {
      "type": "array",
      "description": "Requested roles for this device",
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "object",
      "description": "Device capabilities"
    },
    "auth_strategy": {
      "type": "string",
      "enum": ["PLAYER_PASSWORD", "SERVER_CODE", "RECEIVER_BUTTON", "ED25519_CHALLENGE", "LEGACY"],
      "description": "Desired auth strategy"
    },
    "public_key": {
      "type": "string",
      "description": "Ed25519 public key (base64) for ED25519_CHALLENGE strategy"
    },
    "challenge_nonce": {
      "type": "string",
      "description": "Random nonce (base64) for ED25519_CHALLENGE challenge-response"
    },
    "challenge_signature": {
      "type": "string",
      "description": "Ed25519 signature of the nonce (base64), proves possession of secret key"
    }
  }
}
