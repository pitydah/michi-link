{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/pair-start.schema.json",
  "title": "PairStart",
  "description": "Initiates a pairing handshake between two devices",
  "type": "object",
  "required": ["device_name", "device_type"],
  "properties": {
    "device_name": {
      "type": "string",
      "description": "Initiating device display name",
      "minLength": 1,
      "maxLength": 128
    },
    "device_type": {
      "type": "string",
      "description": "Initiating device type",
      "examples": ["mobile", "desktop", "receiver"]
    },
    "roles": {
      "type": "array",
      "description": "Requested roles for this device",
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "object",
      "description": "Device capabilities"
    }
  }
}
