{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/receiver-info.schema.json",
  "title": "ReceiverInfo",
  "description": "Canonical receiver device info for the v1-lite protocol. Receivers do not manage libraries, playlists or sync.",
  "type": "object",
  "required": [
    "service",
    "name",
    "version",
    "firmware",
    "api_version",
    "roles",
    "auth",
    "audio",
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Unique receiver identifier",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "examples": [
        "rec-std-001"
      ]
    },
    "service": {
      "type": "string",
      "description": "Receiver service identifier (quality tier)",
      "enum": [
        "michi-stream-standard",
        "michi-stream-hifi"
      ],
      "examples": [
        "michi-stream-standard"
      ]
    },
    "name": {
      "type": "string",
      "description": "Human-readable receiver name",
      "minLength": 1,
      "maxLength": 128,
      "examples": [
        "Michi Music Stream Standard"
      ]
    },
    "version": {
      "type": "string",
      "description": "Application version (internal, not contract version)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": [
        "0.1.0"
      ]
    },
    "firmware": {
      "type": "string",
      "description": "Receiver firmware version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": [
        "0.1.0"
      ]
    },
    "api_version": {
      "type": "string",
      "description": "API contract version. Always 'v1-lite' for receivers.",
      "enum": [
        "v1-lite"
      ],
      "examples": [
        "v1-lite"
      ]
    },
    "roles": {
      "type": "array",
      "description": "Receiver roles. Always exactly audio_receiver.",
      "items": {
        "type": "string",
        "enum": [
          "audio_receiver"
        ]
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "examples": [
        [
          "audio_receiver"
        ]
      ]
    },
    "auth": {
      "type": "object",
      "description": "Authentication configuration for the receiver",
      "additionalProperties": false,
      "required": [
        "required",
        "strategy",
        "token_refresh"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "enum": [
            true
          ],
          "description": "Authentication is always required for receivers"
        },
        "strategy": {
          "type": "string",
          "description": "Auth strategy used by the receiver",
          "enum": [
            "RECEIVER_BUTTON"
          ],
          "examples": [
            "RECEIVER_BUTTON"
          ]
        },
        "token_refresh": {
          "type": "boolean",
          "description": "Whether /token/refresh is supported. Always false for receivers.",
          "enum": [
            false
          ],
          "examples": [
            false
          ]
        }
      }
    },
    "audio": {
      "type": "object",
      "description": "Supported audio formats and limits",
      "additionalProperties": false,
      "required": [
        "codecs",
        "max_sample_rate",
        "max_channels"
      ],
      "properties": {
        "codecs": {
          "type": "array",
          "description": "Supported PCM codecs. Standard: pcm_s16le only; Hi-Fi: pcm_s16le + pcm_s24le. No lossy codecs.",
          "items": {
            "type": "string",
            "enum": [
              "pcm_s16le",
              "pcm_s24le"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "examples": [
            [
              "pcm_s16le"
            ]
          ]
        },
        "max_sample_rate": {
          "type": "integer",
          "description": "Maximum supported sample rate in Hz",
          "minimum": 8000,
          "maximum": 384000,
          "examples": [
            96000
          ]
        },
        "max_channels": {
          "type": "integer",
          "description": "Maximum number of audio channels",
          "minimum": 1,
          "maximum": 8,
          "examples": [
            2
          ]
        }
      }
    },
    "features": {
      "type": "object",
      "description": "Boolean feature flags supported by the receiver",
      "additionalProperties": false,
      "required": [
        "session",
        "volume",
        "heartbeat"
      ],
      "properties": {
        "session": {
          "type": "boolean",
          "description": "Whether the receiver supports audio sessions"
        },
        "volume": {
          "type": "boolean",
          "description": "Whether the receiver supports volume control"
        },
        "heartbeat": {
          "type": "boolean",
          "description": "Whether the receiver sends heartbeats"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "service": {
            "const": "michi-stream-standard"
          }
        }
      },
      "then": {
        "properties": {
          "audio": {
            "type": "object",
            "properties": {
              "codecs": {
                "enum": [
                  [
                    "pcm_s16le"
                  ]
                ],
                "type": "array"
              },
              "max_sample_rate": {
                "maximum": 96000,
                "type": "integer"
              },
              "max_channels": {
                "minimum": 2,
                "maximum": 2,
                "type": "integer"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "service": {
            "const": "michi-stream-hifi"
          }
        }
      },
      "then": {
        "properties": {
          "audio": {
            "type": "object",
            "properties": {
              "codecs": {
                "items": {
                  "enum": [
                    "pcm_s16le",
                    "pcm_s24le"
                  ]
                },
                "contains": {
                  "const": "pcm_s16le"
                },
                "type": "array"
              },
              "max_sample_rate": {
                "maximum": 192000,
                "type": "integer"
              },
              "max_channels": {
                "minimum": 2,
                "maximum": 2,
                "type": "integer"
              }
            }
          }
        }
      }
    }
  ]
}