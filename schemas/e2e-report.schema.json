{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://michi.link/schemas/e2e-report.schema.json",
  "title": "E2EReport",
  "description": "Formal E2E certification report for Michi Link API scenarios",
  "type": "object",
  "required": ["scenario", "name", "status", "server", "client", "timestamp", "checks"],
  "properties": {
    "scenario": {
      "type": "string",
      "description": "E2E scenario ID (e.g. E2E-01)",
      "pattern": "^E2E-\\d{2}$",
      "examples": ["E2E-01"]
    },
    "name": {
      "type": "string",
      "description": "Human-readable scenario name",
      "examples": ["mobile_player_pairing"]
    },
    "status": {
      "type": "string",
      "description": "Overall certification result",
      "enum": ["pass", "fail", "partial"]
    },
    "server": {
      "type": "object",
      "required": ["type", "version"],
      "properties": {
        "type": { "type": "string", "examples": ["michi-music-player", "michi-micro-server"] },
        "version": { "type": "string", "examples": ["0.1.0"] }
      }
    },
    "client": {
      "type": "object",
      "required": ["type", "version"],
      "properties": {
        "type": { "type": "string", "examples": ["michi-mobile", "michi-music-player"] },
        "version": { "type": "string", "examples": ["0.1.0"] }
      }
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp when the test was executed",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "description": "Individual check results",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "detail": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "errors": {
      "type": "array",
      "description": "Error messages if status is fail or partial",
      "items": { "type": "string" }
    },
    "certified_by": {
      "type": "string",
      "description": "Email or username of the certifier",
      "examples": ["desarrollador@example.com"]
    },
    "certified_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of certification",
      "format": "date-time"
    }
  }
}
