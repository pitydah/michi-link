{
  "device_id": "rec-hifi-001",
  "service": "michi-stream-hifi",
  "name": "Michi Music Stream Hi-Fi",
  "version": "0.1.0",
  "firmware": "0.1.0",
  "api_version": "v1-lite",
  "roles": ["audio_receiver"],
  "auth": {
    "required": true,
    "strategy": "RECEIVER_BUTTON",
    "token_refresh": false
  },
  "audio": {
    "codecs": ["pcm_s16le", "pcm_s24le"],
    "max_sample_rate": 192000,
    "max_channels": 2
  },
  "features": {
    "session": true,
    "volume": true,
    "heartbeat": true
  }
}
