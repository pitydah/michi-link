{
  "device_id": "rec-std-001",
  "service": "michi-stream-standard",
  "name": "Michi Music Stream Standard",
  "version": "0.1.0",
  "firmware": "0.1.0",
  "api_version": "v1-lite",
  "roles": ["audio_receiver"],
  "auth": {
    "required": true,
    "strategy": "RECEIVER_BUTTON",
    "token_refresh": false
  },
  "audio": {
    "codecs": ["pcm_s16le"],
    "max_sample_rate": 96000,
    "max_channels": 2
  },
  "features": {
    "session": true,
    "volume": true,
    "heartbeat": true
  }
}
